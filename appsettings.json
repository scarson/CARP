{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5050",
  "Crimes": {
    "JwtAlgNone": false,
    "SignNull": false,
    "LieAboutStatus": true,
    "LatencyHomeopathy": true,
    "WeakETag": true,
    "ECBMarker": true
  },
  "ReverseProxy": {
    "Routes": {
      "demo": {
        "ClusterId": "demoCluster",
        "Match": {
          "Path": "/proxy/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/proxy" }
        ]
      }
    },
    "Clusters": {
      "demoCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://httpbin.org/"
          }
        }
      }
    }
  }
}
